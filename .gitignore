# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/

# Regenerated from the pinned @techstark/opencv-js on every build by the
# `prebuild` script -- see scripts/sync-opencv.mjs. Eleven megabytes of
# Emscripten output does not belong in git history, and leaving it merely
# UNTRACKED was worse than either: a git-push deploy shipped a /detection
# route that 404'd its own runtime with nothing in the build log to say why.
/public/wasm/opencv.js
# verification builds, kept out of the dev server's way -- see distDir in
# next.config.ts
/.next-verify/

# Generated test fixtures -- scripts/sfm-camera-fixture.mjs
/.fixtures/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# AND .config, WHICH IS NOT COVERED BY .env* AND HOLDS LIVE CREDENTIALS.
# It carries AWS_ACCESS_KEY, AWS_SECRET_KEY and DB_CONNECTION. It was
# untracked but unignored, which is one `git add -A` away from putting a
# secret key in this repository's history permanently -- and history is not
# something a later commit can take back.
.config

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference material (large video files, not project source)
/sources

# orphaned assets, unreferenced by any rendered component in src/ -- kept on
# disk locally, not shipped to git/Vercel
/public/models/Base/
/public/models/cube.glb
/public/models/tornado.glb
/public/models/ditto.glb
/public/water/blue.png
/public/water/moss.png
/public/water/tiles.jpg
/public/water/tiles_bw.png
/public/water/tiles_full.png
/public/water/tiles_gray_white.png
/public/water/worn.png
.neon

# simulation: the pinned CropCraft checkout and Blender-side packages
# (recreated by sim/setup.sh), and every generated field, cloud and model.
# Generated data is reproducible from a seed; committing it would only add
# weight. The one exception is the scan the viewer serves, in public/scans/.
/sim/.cache/
/data/
__pycache__/
